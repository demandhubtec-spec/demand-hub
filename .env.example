# Copie este arquivo para ".env" e preencha com as chaves do seu projeto Supabase
# (Project Settings → API, no painel do Supabase).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Alguns projetos Supabase geram a chave anônima com o nome abaixo — use a que
# aparecer no seu painel:
# VITE_SUPABASE_PUBLISHABLE_KEY=
