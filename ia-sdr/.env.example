# ── OpenAI (platform.openai.com → API keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Opcional, só para modelos de raciocínio: low | medium | high
OPENAI_REASONING_EFFORT=

# ── Supabase (Project Settings → API). Use a service role SÓ no servidor.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Evolution GO
EVOLUTION_API_URL=https://evo.demandhub.com.br
# Token da INSTÂNCIA da DemandIA (não é a chave global do servidor)
EVOLUTION_INSTANCE_TOKEN=
EVOLUTION_INSTANCE=demandia
# Segredo que vai na URL do webhook (?secret=...). Gere com: openssl rand -hex 24
WEBHOOK_SECRET=

# ── Google Agenda (Google Cloud Console → Credenciais → ID do cliente OAuth "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# ── App
APP_URL=https://demandia-sdr.vercel.app
ADMIN_SECRET=
CRON_SECRET=
# Seu WhatsApp para receber avisos (reunião marcada, handoff). Só dígitos: 55DDDNUMERO
ALERT_PHONE=5519988506553
OWNER_PHONE=5519988506553
